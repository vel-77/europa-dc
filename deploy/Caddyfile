# Caddy gets and renews the HTTPS certificates for every address below by itself.
# It sets no upload size limit, so admin photo uploads pass through.

# The site itself.
{$SITE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy frontend:3000
}

# Other addresses that should land on the site, e.g. www or an old temporary
# address: a comma-separated list in REDIRECT_DOMAINS. The default is a
# placeholder Caddy serves with its own internal certificate and never
# requests a public certificate for.
{$REDIRECT_DOMAINS:redirect.localhost} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
