# Copy to .env in the repository root on the server.
# The address the site is served at; its DNS A/AAAA records must point to this server.
SITE_DOMAIN=europa-dc.com
# Optional: other addresses that redirect to SITE_DOMAIN, comma-separated.
# Their DNS must point to this server too.
REDIRECT_DOMAINS=www.europa-dc.com
# Password for /admin
ADMIN_PASSWORD=
# Random string, at least 32 characters: openssl rand -hex 32
SESSION_SECRET=
